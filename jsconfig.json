{
  // Type-checks the Node-side JS (Netlify Functions + scripts) against their
  // JSDoc contracts using `tsc --checkJs`, with NO rewrite to TypeScript.
  //
  // Strictness is pragmatic, not `--strict`: this is an existing JSDoc-typed
  // codebase whose serverless edges (Netlify Blobs store shapes, request
  // context) are loosely typed. Full strict mode surfaces ~600 edge-typing
  // findings that are not bugs. We run with checkJs on and a small documented
  // baseline (scripts/typecheck.mjs) so the type-error count can only shrink.
  //
  // The browser bundles under static/*.js are excluded here; CI syntax-checks
  // them separately with `node -c`.
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["netlify/**/*.mjs", "scripts/**/*.mjs", "types/**/*.d.ts"],
  "exclude": ["node_modules", "**/.netlify/**", "static", "test"]
}
