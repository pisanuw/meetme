{
  "name": "meetme",
  "private": true,
  "description": "MeetMe — a scheduling app combining Doodle-style group availability meetings with Calendly-style bookable event types, built on Netlify Functions and Blobs.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "git config core.hooksPath scripts/hooks || true",
    "dev": "netlify dev --internal-disable-edge-functions --no-open -p 8888",
    "dev:offline": "netlify dev --internal-disable-edge-functions --offline --no-open -p 8888",
    "dev:oauth": "APP_URL=http://localhost:8888 netlify dev --internal-disable-edge-functions --no-open -p 8888",
    "dev:stop": "pkill -f \"[n]etlify dev\" || true",
    "env:decrypt": "node scripts/decrypt-sops-env.mjs .env.asc .env",
    "fix:deps": "rm -rf node_modules && npm ci",
    "test": "node --test test/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=78 --test-coverage-branches=50 --test-coverage-functions=50 test/*.test.mjs",
    "test:e2e:smoke": "playwright test -c playwright.smoke.config.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "eslint . --max-warnings 0",
    "smoke:staging": "node scripts/staging-smoke.mjs",
    "predeploy-check": "npm test && npm run typecheck && npm run lint",
    "predeploy:full": "npm run predeploy-check && npm run test:e2e:smoke",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.9",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.20.0",
    "eslint": "^9.21.0",
    "globals": "^15.15.0",
    "http-server": "^14.1.1",
    "netlify-cli": "^24.8.0",
    "prettier": "^3.5.3",
    "typescript": "^5.9.3"
  }
}
