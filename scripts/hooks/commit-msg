#!/usr/bin/env bash
# Enforce Conventional Commits on the first line of the commit message.
set -euo pipefail

header=$(head -n1 "$1")

# Let git-generated and in-progress commits through unchecked.
case "$header" in
  Merge*|Revert*|"fixup! "*|"squash! "*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+'
if ! printf '%s' "$header" | grep -Eq "$pattern"; then
  cat >&2 <<'MSG'
✖ Commit message must follow Conventional Commits:
    <type>(<optional scope>): <description>
  types: feat fix docs style refactor perf test build ci chore revert
  example: fix(auth): reject expired magic-link tokens
MSG
  echo "  got: $header" >&2
  exit 1
fi
